# IKAY is a static site with no build: everything in the repo is published,
# so keep local noise out. LUZ is installed with npm for development and
# copied to assets/vendor/luz/ (npm run luz:sync), which is what is served.

# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# Editors and IDEs
.vscode/*
!.vscode/extensions.json
.idea/
.project
.settings/
nbproject/
*.swp
*.swo
*.sublime-workspace
tags

# Claude Code: shared agents are versioned, personal settings are not
.claude/*
!.claude/agents/
.claude/settings.local.json
CLAUDE.local.md

# Local servers, logs and temporary files
*.log
.cache/
tmp/
*.tmp

# Installed with npm install (package-lock.json is versioned)
node_modules/

# Local secrets
.env
.env.*
